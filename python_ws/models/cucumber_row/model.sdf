<?xml version="1.0" ?>
<!--
  黄瓜种植行模型 (Cucumber Row)
  长度: 16m (沿X轴), 高1.8m
  ★ 第十三次缩小: 36m→16m, 配合缩小后的大棚(20×12m)
  包含: 竹竿支撑 + 横向牵引线 + 叶片遮挡块
-->
<sdf version="1.6">
  <model name="cucumber_row">
    <static>true</static>

    <!-- 底部土垄 -->
    <link name="soil_ridge">
      <pose>0 0 0.15 0 0 0</pose>
      <collision name="c"><geometry><box><size>16 0.6 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16 0.6 0.3</size></box></geometry>
        <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.28 0.15 1</diffuse></material>
      </visual>
    </link>

    <!-- 竹竿支撑 (每隔1.5m, 共11根, x从-7.5到7.5) -->
    <link name="stake_0"><pose>-7.5 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_1"><pose>-6.0 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_2"><pose>-4.5 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_3"><pose>-3.0 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_4"><pose>-1.5 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_5"><pose>0 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_6"><pose>1.5 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_7"><pose>3.0 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_8"><pose>4.5 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_9"><pose>6.0 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>
    <link name="stake_10"><pose>7.5 0 1.05 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.015</radius><length>1.8</length></cylinder></geometry><material><ambient>0.6 0.5 0.2 1</ambient><diffuse>0.7 0.6 0.3 1</diffuse></material></visual></link>

    <!-- 上方横向牵引钢丝 -->
    <link name="top_wire"><pose>0 0 1.9 0 0 0</pose>
      <collision name="c"><geometry><box><size>16 0.01 0.01</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16 0.01 0.01</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
    </link>
    <link name="mid_wire"><pose>0 0 1.3 0 0 0</pose>
      <collision name="c"><geometry><box><size>16 0.01 0.01</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>16 0.01 0.01</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
    </link>

    <!-- 叶片遮挡 -->
    <link name="foliage_low"><pose>0 0 0.9 0 0 0</pose>
      <collision name="c"><geometry><box><size>14 0.4 0.6</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>14 0.4 0.6</size></box></geometry>
        <material><ambient>0.15 0.45 0.1 0.7</ambient><diffuse>0.2 0.55 0.15 0.7</diffuse></material>
        <transparency>0.3</transparency>
      </visual>
    </link>
    <link name="foliage_high"><pose>0 0 1.5 0 0 0</pose>
      <collision name="c"><geometry><box><size>14 0.35 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>14 0.35 0.5</size></box></geometry>
        <material><ambient>0.1 0.4 0.08 0.6</ambient><diffuse>0.15 0.5 0.1 0.6</diffuse></material>
        <transparency>0.35</transparency>
      </visual>
    </link>

  </model>
</sdf>
