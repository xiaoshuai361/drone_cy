<?xml version="1.0" ?>
<!--
  黄瓜大棚仿真世界
  包含: 1个大棚(20m×12m) + 6行黄瓜种植行 (行间距1.8m)
  ★ 第十三次缩小: 40×16→20×12, 10行→6行
  GPS拒止环境 - 用于测试 Fast-LIO2 SLAM
-->
<sdf version="1.6">
  <world name="greenhouse_world">

    <!-- 物理引擎配置 (PX4标准) -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>10</iters><sor>1.3</sor><use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling></solver>
        <constraints><cfm>0</cfm><erp>0.2</erp><contact_max_correcting_vel>100</contact_max_correcting_vel><contact_surface_layer>0.001</contact_surface_layer></constraints>
      </ode>
    </physics>

    <!-- 光照 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.35 0.28 0.18 1</ambient><diffuse>0.45 0.35 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 大棚主体 (40m x 16m) -->
    <include>
      <uri>model://greenhouse</uri>
      <pose>0 0 0 0 0 0</pose>
      <name>greenhouse_main</name>
    </include>

    <!-- 黄瓜种植行 (6行, 行间距1.8m, 居中放置) -->
    <!-- y范围: -4.5 到 +4.5, 居中分布 -->
    <include><uri>model://cucumber_row</uri><pose>0 -4.5 0 0 0 0</pose><name>row_1</name></include>
    <include><uri>model://cucumber_row</uri><pose>0 -2.7 0 0 0 0</pose><name>row_2</name></include>
    <include><uri>model://cucumber_row</uri><pose>0 -0.9 0 0 0 0</pose><name>row_3</name></include>
    <include><uri>model://cucumber_row</uri><pose>0 0.9 0 0 0 0</pose><name>row_4</name></include>
    <include><uri>model://cucumber_row</uri><pose>0 2.7 0 0 0 0</pose><name>row_5</name></include>
    <include><uri>model://cucumber_row</uri><pose>0 4.5 0 0 0 0</pose><name>row_6</name></include>

  </world>
</sdf>
