<?xml version="1.0"?>
<launch>
    <!--
        SLAM 建图启动文件
        组件:
        1. Fast-LIO2 (LiDAR-惯导融合定位与建图)
        2. OctoMap Server (3D占据栅格地图)
        3. RViz 可视化
    -->

    <!-- ========== Fast-LIO2 ========== -->
    <rosparam command="load" file="$(find mak4_sim)/config/fastlio_sim_mid360.yaml" />

    <param name="feature_extract_enable" type="bool" value="0"/>
    <param name="point_filter_num" type="int" value="2"/>
    <param name="max_iteration" type="int" value="4"/>
    <param name="filter_size_surf" type="double" value="0.15"/>
    <param name="filter_size_map" type="double" value="0.15"/>
    <param name="cube_side_length" type="double" value="500"/>
    <param name="runtime_pos_log_enable" type="bool" value="0"/>

    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"/>

    <!-- ========== 点云NaN过滤 ========== -->
    <node pkg="mak4_sim" type="nan_filter.py" name="nan_filter" output="screen"/>

    <!-- ========== 点云降频 (10Hz→2Hz) ========== -->
    <!-- nan_filter已做体素降采样(~10000→~1500点), 2Hz足够OctoMap处理 -->
    <node pkg="topic_tools" type="throttle" name="cloud_throttle"
          args="messages /cloud_filtered 2.0 /cloud_throttled"/>

    <!-- ========== OctoMap Server ========== -->
    <!-- 将Fast-LIO2累积的点云转换为3D占据栅格 -->
    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server" output="screen">
        <param name="resolution" value="0.15"/>
        <param name="frame_id" value="camera_init"/>
        <!-- ★ 第十六次修复: 平衡策略 (hit强/miss极弱/min恢复默认) -->
        <!-- 第十五次的min=0.51导致整个空间被噪点永久填满! -->
        <!-- 正确做法: 用极弱miss让墙壁自然抗侵蚀, 而非禁止概率下降 -->
        <param name="sensor_model/max_range" value="15.0"/>
        <!-- hit=0.9: logit=+2.20, 每次击中给予强占据证据 -->
        <param name="sensor_model/hit" value="0.9"/>
        <!-- miss=0.47: logit=-0.12, 极弱的自由空间标记 -->
        <!-- 墙壁从max(0.97)降到threshold(0.5)需要29次miss≈14.5秒连续射线穿过 -->
        <!-- 噪点(1次hit)清除只需18次miss≈9秒 → 噪点能清理, 墙壁很稳固 -->
        <param name="sensor_model/miss" value="0.47"/>
        <!-- min=0.12: 恢复默认! 允许概率降到0.12, 噪点可以被完全清理 -->
        <param name="sensor_model/min" value="0.12"/>
        <!-- max=0.97: 占据上限, 墙壁最高到0.97 -->
        <param name="sensor_model/max" value="0.97"/>
        <param name="occupancy_min_z" value="-5.0"/>
        <param name="occupancy_max_z" value="20.0"/>
        <param name="latch" value="false"/>
        <param name="filter_ground" value="false"/>
        <remap from="cloud_in" to="/cloud_throttled"/>
    </node>

    <!-- ========== 静态TF: map -> camera_init ========== -->
    <!-- Fast-LIO2 使用 camera_init 作为全局坐标系, RViz显示需要 -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="map_to_camera_init" 
          args="0 0 0 0 0 0 map camera_init"/>

    <!-- ★ 第十七次修复: 移除了以下两个导致TF树冲突的静态变换 -->
    <!-- 旧: odom -> map (identity) — 与 MAVROS 的 odom -> base_link 形成环路 -->
    <!-- 旧: body -> base_link (identity) — 创建第二条到 base_link 的路径 -->
    <!-- TF树现在是两棵独立的树: -->
    <!--   树1 (SLAM): map -> camera_init -> body  (Fast-LIO2) -->
    <!--   树2 (MAVROS): odom -> base_link          (PX4 EKF2) -->
    <!-- OctoMap 只用树1: 点云在body帧, TF(body->camera_init)给出正确sensor origin -->

    <!-- ========== RViz 可视化 ========== -->
    <arg name="rviz" default="true"/>
    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="rviz_slam" 
              args="-d $(find mak4_sim)/config/slam_mapping.rviz" output="screen"/>
    </group>
</launch>
