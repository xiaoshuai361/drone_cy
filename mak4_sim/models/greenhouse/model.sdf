    <link name="ds18"><pose>2.2 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds19"><pose>2.8 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds20"><pose>3.4 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds21"><pose>4.0 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds22"><pose>4.6 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds23"><pose>5.2 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds24"><pose>5.8 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds25"><pose>6.4 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds26"><pose>7.0 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds27"><pose>7.6 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <!-- 纵向深色沟 (与横向交叉, 形成泥土网格纹理) -->
    <link name="dc1"><pose>0 -5.0 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>
    <link name="dc2"><pose>0 -3.5 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>
    <link name="dc3"><pose>0 -2.0 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>
    <link name="dc4"><pose>0 -0.5 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>
    <link name="dc5"><pose>0 1.0 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>
    <link name="dc6"><pose>0 2.5 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>
    <link name="dc7"><pose>0 4.0 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>
    <link name="dc8"><pose>0 5.5 0.024 0 0 0</pose><visual name="v"><geometry><box><size>20 0.06 0.005</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.5 0.38 0.26 1</diffuse></material></visual></link>

    <!-- 左侧墙壁 (y=-6) -->
    <link name="wall_left">
      <pose>0 -6 2.0 0 0 0</pose>
      <collision name="col"><geometry><box><size>20 0.05 4.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>20 0.05 4.0</size></box></geometry>
        <material><ambient>0.8 0.85 0.8 0.3</ambient><diffuse>0.9 0.95 0.9 0.3</diffuse></material>
        <transparency>0.6</transparency>
      </visual>
    </link>

    <!-- 右侧墙壁 (y=6) -->
    <link name="wall_right">
      <pose>0 6 2.0 0 0 0</pose>
      <collision name="col"><geometry><box><size>20 0.05 4.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>20 0.05 4.0</size></box></geometry>
        <material><ambient>0.8 0.85 0.8 0.3</ambient><diffuse>0.9 0.95 0.9 0.3</diffuse></material>
        <transparency>0.6</transparency>
      </visual>
    </link>

    <!-- 前端墙壁 (x=-10, 留门洞 3m宽) -->
    <link name="wall_front_l">
      <pose>-10 -3.75 2.0 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.05 4.5 4.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.05 4.5 4.0</size></box></geometry>
        <material><ambient>0.8 0.85 0.8 0.3</ambient><diffuse>0.9 0.95 0.9 0.3</diffuse></material>
        <transparency>0.6</transparency>
      </visual>
    </link>
    <link name="wall_front_r">
      <pose>-10 3.75 2.0 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.05 4.5 4.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.05 4.5 4.0</size></box></geometry>
        <material><ambient>0.8 0.85 0.8 0.3</ambient><diffuse>0.9 0.95 0.9 0.3</diffuse></material>
        <transparency>0.6</transparency>
      </visual>
    </link>

    <!-- 后端墙壁 (x=10) -->
    <link name="wall_back">
      <pose>10 0 2.0 0 0 0</pose>
      <collision name="col"><geometry><box><size>0.05 12.0 4.0</size></box></geometry></collision>
      <visual name="vis"><geometry><box><size>0.05 12.0 4.0</size></box></geometry>
        <material><ambient>0.8 0.85 0.8 0.3</ambient><diffuse>0.9 0.95 0.9 0.3</diffuse></material>
        <transparency>0.6</transparency>
      </visual>
    </link>

    <!-- 拱形屋顶骨架 (每隔4m, 共6对) -->
    <link name="arch_m10_l"><pose>-10 -3 4.2 0 0.25 0</pose><collision name="c"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link>
    <link name="arch_m10_r"><pose>-10 3 4.2 0 -0.25 0</pose><collision name="c"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link>

    <link name="arch_m6_l"><pose>-6 -3 4.2 0 0.25 0</pose><collision name="c"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link>
