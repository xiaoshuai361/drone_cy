    <link name="arch_2_l"><pose>2 -3 4.2 0 0.25 0</pose><collision name="c"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.03</radius><length>7.0</length></cylinder></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual></link>
