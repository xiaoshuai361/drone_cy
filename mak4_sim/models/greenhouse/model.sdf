    <!-- 竖直支撑柱 (每隔5m, 左右各一) -->
    <link name="pillar_m5_l"><pose>-5 -5.9 2.0 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.04</radius><length>4.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.04</radius><length>4.0</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link>
