<?xml version="1.0" ?>
<!--
  黄瓜大棚模型 (Cucumber Greenhouse)
  尺寸: 长20m x 宽12m x 高5m (拱形顶)
  ★ 第十三次缩小: 40×16→20×12, 方便测试
  包含: 棚架结构、横梁、模拟藤蔓线
  所有部件都有碰撞体积用于避障测试
-->
<sdf version="1.6">
  <model name="greenhouse">
    <static>true</static>

    <!-- 地基/地面 (泥土色+纹理条纹, 增强光流效果) -->
    <link name="floor">
      <pose>0 0 0.01 0 0 0</pose>
      <collision name="floor_col"><geometry><box><size>20 12 0.02</size></box></geometry></collision>
      <visual name="floor_vis"><geometry><box><size>20 12 0.02</size></box></geometry>
        <material>
          <ambient>0.5 0.4 0.3 1</ambient>
          <diffuse>0.6 0.45 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ★ 第十五次新增: 泥土地面纹路 (给光流传感器提供特征) -->
    <!-- 横向泥土垄 (宽8cm, 间隔0.6m, 模拟种植行泥土沟壑) -->
    <link name="ds1"><pose>-8.0 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds2"><pose>-7.4 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds3"><pose>-6.8 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds4"><pose>-6.2 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds5"><pose>-5.6 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds6"><pose>-5.0 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds7"><pose>-4.4 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
    <link name="ds8"><pose>-3.8 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
