    <!-- 藤蔓牵引线 (横向遮挡障碍物) -->
    <link name="wire_1"><pose>-6 0 2.0 0 0 0</pose><collision name="c"><geometry><box><size>0.02 10.0 0.02</size></box></geometry></collision><visual name="v"><geometry><box><size>0.02 10.0 0.02</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual></link>
    <link name="wire_2"><pose>-2 0 2.0 0 0 0</pose><collision name="c"><geometry><box><size>0.02 10.0 0.02</size></box></geometry></collision><visual name="v"><geometry><box><size>0.02 10.0 0.02</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual></link>
