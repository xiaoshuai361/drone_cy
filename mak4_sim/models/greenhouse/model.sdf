    <!-- 纵向横梁 -->
    <link name="ridge_beam"><pose>0 0 4.8 0 0 0</pose><collision name="c"><geometry><box><size>20 0.04 0.04</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.04 0.04</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link>
    <link name="purlin_l"><pose>0 -3.5 3.5 0 0 0</pose><collision name="c"><geometry><box><size>20 0.04 0.04</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.04 0.04</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link>
