    <link name="ds15"><pose>0.4 0 0.022 0 0 0</pose><visual name="v"><geometry><box><size>0.08 12 0.006</size></box></geometry><material><ambient>0.55 0.42 0.28 1</ambient><diffuse>0.65 0.5 0.35 1</diffuse></material></visual></link>
