<?xml version="1.0" ?>
<!--
  MAK4 iris + RGB-D Camera + Mid360 3D LiDAR + 下视测距仪 + 下视光流
  - RGB-D: 前向, 320x240, 10fps, ROS topics: /camera/rgb, /camera/depth, /camera/depth/points
  - LiDAR: 360°水平, -7°~52° 垂直, ~10Hz, ROS topic: /mid360/points
  - 测距仪: 下视 1D 激光测距, 50Hz, PX4 MAVLink (DISTANCE_SENSOR)
  - 光流: 下视 PX4Flow, 20Hz, PX4 MAVLink (OPTICAL_FLOW_RAD)
  ★ 模拟微空 MTF-01P 光流测距一体模块
-->
<sdf version="1.6">
  <model name="iris_rgbd_lidar">

    <!-- 基础 iris 四旋翼 -->
    <include>
      <uri>model://iris</uri>
    </include>

    <!-- ============================================ -->
    <!--  RGB-D 深度相机 (前向安装, 模拟 Intel RealSense D435i) -->
    <!-- ============================================ -->
    <link name="camera_link">
      <pose>0.12 0 0.0 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <sensor name="rgbd_camera" type="depth">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <camera>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <horizontal_fov>1.2217</horizontal_fov>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <plugin filename="libgazebo_ros_openni_kinect.so" name="rgbd_camera_controller">
          <cameraName>camera</cameraName>
          <robotNamespace>/</robotNamespace>
          <alwaysOn>true</alwaysOn>
          <updateRate>10</updateRate>
          <pointCloudCutoff>0.1</pointCloudCutoff>
          <pointCloudCutoffMax>10.0</pointCloudCutoffMax>
          <imageTopicName>rgb/image_raw</imageTopicName>
          <cameraInfoTopicName>rgb/camera_info</cameraInfoTopicName>
          <depthImageTopicName>depth/image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>depth/points</pointCloudTopicName>
          <frameName>camera_link</frameName>
          <distortion_k1>0.0</distortion_k1>
          <distortion_k2>0.0</distortion_k2>
          <distortion_k3>0.0</distortion_k3>
          <distortion_t1>0.0</distortion_t1>
          <distortion_t2>0.0</distortion_t2>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <child>camera_link</child>
      <parent>iris::base_link</parent>
    </joint>

    <!-- ============================================ -->
    <!--  Mid360 3D LiDAR (顶部安装)                   -->
    <!--  参数: 360° 水平FOV, 垂直 -7°~52°            -->
    <!--  ~200000 点/秒, 10Hz → 360线 x 非均匀采样     -->
    <!--  Gazebo近似: gpu_ray 传感器                    -->
    <!-- ============================================ -->
    <link name="lidar_link">
      <pose>0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>2.5e-4</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.5e-4</iyy><iyz>0</iyz><izz>2.5e-4</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <collision name="lidar_collision">
        <geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <sensor name="mid360_lidar" type="gpu_ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.1222</min_angle>  <!-- -7 degrees -->
              <max_angle>0.9076</max_angle>   <!-- 52 degrees -->
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.003</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin filename="libgazebo_ros_velodyne_gpu_laser.so" name="mid360_lidar_plugin">
          <topicName>/mid360/points</topicName>
          <frameName>lidar_link</frameName>
          <min_range>0.1</min_range>
          <max_range>40.0</max_range>
          <gaussianNoise>0.008</gaussianNoise>
        </plugin>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <child>lidar_link</child>
      <parent>iris::base_link</parent>
    </joint>

    <!-- ============================================ -->
    <!--  下视激光测距仪 (模拟 MTF-01P 测距部分)        -->
    <!--  1D单线激光, 向下测量对地距离                    -->
    <!--  通过 PX4 MAVLink 直接发送 DISTANCE_SENSOR     -->
    <!--  PX4 EKF2 融合后提供精确高度估计                -->
    <!-- ============================================ -->
    <link name="rangefinder_link">
      <pose>0 0 -0.03 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>2.2e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.2e-6</iyy><iyz>0</iyz><izz>1.8e-7</izz>
        </inertia>
      </inertial>
      <visual name="rangefinder_visual">
        <geometry><cylinder><radius>0.006</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <sensor name="rangefinder" type="ray">
        <pose>0 0 0 0 1.5708 0</pose>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.06</min>
            <max>35</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="RangefinderPlugin" filename="libgazebo_lidar_plugin.so">
          <robotNamespace></robotNamespace>
          <min_distance>0.04</min_distance>
          <max_distance>8.0</max_distance>
        </plugin>
      </sensor>
    </link>
    <joint name="rangefinder_joint" type="fixed">
      <child>rangefinder_link</child>
      <parent>iris::base_link</parent>
    </joint>

    <!-- ============================================ -->
    <!--  下视光流传感器 (模拟 MTF-01P 光流部分)         -->
    <!--  模拟 PX4Flow 光流模块, 64x64 灰度相机          -->
    <!--  通过 PX4 MAVLink 直接发送 OPTICAL_FLOW_RAD    -->
    <!--  PX4 EKF2 融合后提供室内水平位置估计             -->
    <!-- ============================================ -->
    <link name="flow_link">
      <pose>0.02 0 -0.03 -1.5708 1.5708 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>4.2e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.4e-6</iyy><iyz>0</iyz><izz>2.4e-6</izz>
        </inertia>
      </inertial>
      <visual name="flow_visual">
        <geometry><box><size>0.005 0.03 0.01</size></box></geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <!-- PX4Flow 内置 IMU -->
      <sensor name="px4flow_imu" type="imu">
        <pose>0 0 0 0 -1.5708 3.14159</pose>
        <always_on>true</always_on>
        <update_rate>200</update_rate>
      </sensor>
      <!-- PX4Flow 下视光流相机 -->
      <sensor name="px4flow" type="camera">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>0.25</horizontal_fov>
          <lens>
            <type>gnomonical</type>
            <scale_to_hfov>false</scale_to_hfov>
          </lens>
          <image>
            <width>64</width>
            <height>64</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </camera>
        <plugin name="opticalflow_plugin" filename="libgazebo_opticalflow_plugin.so">
          <robotNamespace></robotNamespace>
          <outputRate>20</outputRate>
          <hasGyro>true</hasGyro>
          <gyroTopic>/px4flow/imu</gyroTopic>
        </plugin>
      </sensor>
    </link>
    <joint name="flow_joint" type="revolute">
      <parent>iris::base_link</parent>
      <child>flow_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

  </model>
</sdf>
